APP_NAME=OmniVEN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/New_York

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- OmniVEN ---------------------------------------------------------
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Only this Google Workspace domain can sign in
OMNIVEN_ALLOWED_DOMAIN=39dollarglasses.com
# Comma-separated permanent admins
OMNIVEN_ADMIN_EMAILS=drmarcweinstein@39dollarglasses.com

# PulseToPost status card (read-only). Leave the token empty to hide the card.
PULSETOPOST_BASE_URL=https://pulsetopost.com
PULSETOPOST_API_TOKEN=

# Sales (revenue strip and Sales page) from Google Analytics 4, read-only.
# GA4_CREDENTIALS: the service account JSON key (raw or base64). GA4_PROPERTIES: brand=propertyId pairs.
GA4_CREDENTIALS=
GA4_PROPERTIES=
OMNIVEN_REVENUE_VIEWERS=

# Affiliate scoreboard (read-only). CJ personal access token + CID; Awin API token.
CJ_API_TOKEN=
CJ_ADVERTISER_ID=
AWIN_API_TOKEN=
AWIN_ADVERTISER_ID=95501
AWIN_REGION=US

# Reviews page: automatic Shopper Approved and Trustpilot ratings and reviews (read-only).
SHOPPERAPPROVED_SITE_ID=
SHOPPERAPPROVED_API_TOKEN=
TRUSTPILOT_API_KEY=
TRUSTPILOT_BUSINESS_UNIT_ID=
OMNIVEN_REVIEW_OWNER=leona.p@39dollarglasses.com

# Email & SMS health (read-only Klaviyo private key: Campaigns, Flows, Lists, Metrics).
KLAVIYO_PRIVATE_KEY=

# Search page: Search Console property per brand (uses the GA4 service account).
SEARCH_CONSOLE_SITES=
